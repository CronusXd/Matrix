{
  "$schema": "https://json.schemastore.org/nycrc",
  "all": true,
  "include": [
    "pipeline/scripts/**/*.js",
    "pipeline/plugins/**/*.js"
  ],
  "exclude": [
    "pipeline/scripts/lib/**",
    "pipeline/tests/**",
    "**/*.test.js"
  ],
  "reporter": ["text", "lcov", "json-summary"],
  "check-coverage": true,
  "branches": 70,
  "lines": 80,
  "functions": 80,
  "statements": 80
}
