{
  "root": true,
  "env": {
    "node": true,
    "commonjs": true,
    "es2022": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "rules": {
    "no-var": "off",
    "prefer-const": "warn",
    "no-unused-vars": ["warn", { "args": "none", "varsIgnorePattern": "^_" }],
    "no-undef": "error",
    "no-redeclare": "error",
    "no-duplicate-case": "error",
    "no-empty": ["warn", { "allowEmptyCatch": true }],
    "no-extra-semi": "warn",
    "no-irregular-whitespace": "error",
    "no-unreachable": "error",
    "valid-typeof": "error",
    "curly": ["warn", "multi-line"],
    "eqeqeq": ["warn", "smart"],
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-extend-native": "error",
    "no-loop-func": "warn",
    "no-proto": "error",
    "no-script-url": "error",
    "no-self-compare": "warn",
    "no-sequences": "warn",
    "no-throw-literal": "warn",
    "no-useless-call": "warn",
    "no-useless-concat": "warn",
    "no-with": "error",
    "radix": "warn",
    "no-shadow-restricted-names": "error",
    "no-undef-init": "warn",
    "handle-callback-err": "warn",
    "no-mixed-spaces-and-tabs": "warn",
    "no-trailing-spaces": "warn",
    "comma-dangle": ["warn", "never"],
    "no-multiple-empty-lines": ["warn", { "max": 2, "maxEOF": 1 }],
    "semi": ["warn", "always"],
    "strict": ["warn", "safe"],
    "no-console": "off",
    "no-process-exit": "off",
    "global-require": "off"
  },
  "overrides": [
    {
      "files": ["*.js"],
      "rules": {
        "no-unused-vars": ["warn", { "args": "none", "varsIgnorePattern": "^_" }]
      }
    }
  ],
  "globals": {
    "process": true,
    "Buffer": true,
    "__dirname": true,
    "__filename": true,
    "require": true,
    "module": true,
    "exports": true,
    "setTimeout": true,
    "clearTimeout": true,
    "setInterval": true,
    "clearInterval": true,
    "console": true,
    "Promise": true
  }
}
