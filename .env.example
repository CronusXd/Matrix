# ═══════════════════════════════════════════════════════════════════════════════
#  Matrix Pipeline v2.0 — Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════
# Copie este arquivo para .env e preencha os valores:
#   cp .env.example .env
# Ou no Windows:
#   copy .env.example .env
#
# ⚠️  NUNCA commite o arquivo .env — ele contém secrets.
#     .env.example é o único que deve versionado.
#
# Legenda:
#   [OBRIGATÓRIO]  — Necessário para o funcionamento básico
#   [RECOMENDADO]  — Fortemente recomendado para funcionalidades completas
#   [OPCIONAL]     — Funcionalidade específica; pode deixar vazio
# ═══════════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════════
#  IA PROVIDER — 9ROUTER
# ═══════════════════════════════════════════════════════════════════════════════
# Chave de API do 9Router para comunicação com provedores de IA.
# Obrigatório para usar qualquer modelo de LLM no pipeline.
#
# Exemplo: 9ROUTER_API_KEY=sk-9router-abc123def456ghi789jkl
# [OBRIGATÓRIO]
9ROUTER_API_KEY=sua_chave_9router_aqui

# ═══════════════════════════════════════════════════════════════════════════════
#  Matrix API — Endpoint do Provedor LLM
# ═══════════════════════════════════════════════════════════════════════════════
# URL base da API de inferência de modelos. Usada pelo model-voting e model-router.
# Se não configurado, usa http://127.0.0.1:11434 (Ollama local).
#
# Exemplo: Matrix_API_URL=https://api.9router.com/v1
# [OPCIONAL — default: http://127.0.0.1:11434]
# Matrix_API_URL=

# ═══════════════════════════════════════════════════════════════════════════════
#  RAG — Retrieval-Augmented Generation (Embeddings)
# ═══════════════════════════════════════════════════════════════════════════════
# Chave de API para o serviço de embeddings usado pelo RAG.
# Obrigatório apenas se RAG estiver configurado em modo "hybrid" ou "embeddings".
# Se não configurado, RAG opera em modo "tfidf" (funcional sem chave).
#
# API esperada: POST http://127.0.0.1:20128/v1/embeddings (compatível OpenAI)
# Modelo: kr/claude-sonnet-4.5-thinking-agentic (1536 dimensões)
#
# Comandos de setup:
#   node pipeline/scripts/setup-rag.js
#   node pipeline/scripts/setup-rag.js --force-hybrid   # força modo hybrid
#   node pipeline/scripts/setup-rag.js --force-tfidf    # força modo tfidf
#
# Exemplo: Matrix_RAG_API_KEY=sk-rag-abc123def456
# [OPCIONAL — default: vazio (modo tfidf)]
Matrix_RAG_API_KEY=

# ═══════════════════════════════════════════════════════════════════════════════
#  MEMÓRIA — PostgreSQL Adapter
# ═══════════════════════════════════════════════════════════════════════════════
# String de conexão para o banco PostgreSQL usado como storage de memória.
# Se não configurado, o pipeline opera em modo JSON file-based (fallback automático).
#
# Formato: postgresql://usuario:senha@host:5432/nome_do_banco
#
# Para testar a conexão e criar a tabela:
#   node pipeline/scripts/setup-pg-memory.js
#
# Exemplo: DATABASE_URL=postgresql://matrix:minha-senha@localhost:5432/matrix_memory
# [OPCIONAL — default: vazio (modo JSON file)]
# DATABASE_URL=postgresql://user:pass@localhost:5432/matrix_memory

# ═══════════════════════════════════════════════════════════════════════════════
#  MEMÓRIA — Redis Adapter
# ═══════════════════════════════════════════════════════════════════════════════
# String de conexão para o Redis, usado como cache distribuído e store de sessões.
# Se não configurado, o pipeline usa apenas cache em memória local.
#
# Formato: redis://[:senha]@host:6379[/db]
#
# Exemplo: REDIS_URL=redis://:senha@localhost:6379/0
# [OPCIONAL — default: vazio (cache em memória local)]
REDIS_URL=redis://localhost:6379/0

# ═══════════════════════════════════════════════════════════════════════════════
#  AUTENTICAÇÃO — JWT Secret
# ═══════════════════════════════════════════════════════════════════════════════
# Chave secreta HMAC para assinatura e validação de tokens JWT.
# OBRIGATÓRIA se o auth-config.yaml estiver configurado com provider "jwt".
# Se não configurada, auth-provider.js emitirá erro FATAL.
#
# Gere uma secret segura:
#   Linux/macOS: openssl rand -base64 32
#   PowerShell:  [Convert]::ToBase64String([byte[]]::new(32) | % {$_})
#
# Exemplo: Matrix_JWT_SECRET=7XkFn+2q3rL9pQwY5zR8vB4cM6nA1sD0fG3hJ5kL7=
# [OBRIGATÓRIO se provider=jwt]
# Matrix_JWT_SECRET=sua-chave-secreta-aqui

# ═══════════════════════════════════════════════════════════════════════════════
#  AUTENTICAÇÃO — GitHub OAuth
# ═══════════════════════════════════════════════════════════════════════════════
# Credenciais para login social via GitHub OAuth App.
# Use apenas se o auth-config.yaml tiver provider "github".
#
# Para criar um OAuth App:
#   GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
#
# Exemplo:
#   Matrix_GITHUB_CLIENT_ID=Iv1.abc123def456
#   Matrix_GITHUB_CLIENT_SECRET=gho_abc123def456ghi789jkl
# [OPCIONAL — usado apenas se provider=github]
# Matrix_GITHUB_CLIENT_ID=
# Matrix_GITHUB_CLIENT_SECRET=

# ═══════════════════════════════════════════════════════════════════════════════
#  TELEMETRIA — Opt-In
# ═══════════════════════════════════════════════════════════════════════════════
# Coleta e envio de métricas anônimas de uso do pipeline.
# NON-BLOCKING: nunca crasha o pipeline. Nenhum dado sensível é coletado.
#
# Matrix_TELEMETRY_ENABLED=true ativa o envio de métricas.
# Matrix_TELEMETRY_ENDPOINT é a URL base do servidor que recebe as métricas.
# O payload é enviado via POST para {endpoint}/api/telemetry.
#
# Dados coletados: versão, node version, platform, arch, CPU count,
# memory (total/livre), uptime, feature flags (hasApiUrl, hasJwtSecret, etc).
# NUNCA coleta: código, prompts, tokens, secrets, dados de usuário.
#
# Exemplo:
#   Matrix_TELEMETRY_ENABLED=true
#   Matrix_TELEMETRY_ENDPOINT=http://localhost:3000
# [OPCIONAL — default: desabilitado]
# Matrix_TELEMETRY_ENABLED=false
# Matrix_TELEMETRY_ENDPOINT=

# ═══════════════════════════════════════════════════════════════════════════════
#  MODEL VOTING — Threshold de Consenso
# ═══════════════════════════════════════════════════════════════════════════════
# Threshold mínimo de consenso para o sistema de votação entre modelos.
# Se o consenso entre modelos ficar abaixo deste valor, o sistema faz fallback
# para o model-router (seleção baseada em custo × qualidade).
#
# Valor padrão: 0.6 (60%).
# Range: 0.0 (nenhum consenso necessário) a 1.0 (consenso perfeito).
#
# [OPCIONAL — default: 0.6]
# Matrix_VOTING_CONSENSUS_THRESHOLD=0.6

# ═══════════════════════════════════════════════════════════════════════════════
#  NODE ENVIRONMENT
# ═══════════════════════════════════════════════════════════════════════════════
# Ambiente de execução do Node.js. Controla comportamentos como:
#   development  — Logs verbosos, reload automático, sem cache agressivo
#   production   — Logs mínimos, cache máximo, otimizações ativas
#   test         — Modo de teste (suprime certos logs)
#
# Exemplo: NODE_ENV=production
# [RECOMENDADO — default: development]
NODE_ENV=development

# ═══════════════════════════════════════════════════════════════════════════════
#  LOG LEVEL
# ═══════════════════════════════════════════════════════════════════════════════
# Nível de logging do pipeline. Valores válidos:
#   silent   — Sem logs (exceto erros fatais)
#   errors   — Apenas erros
#   warn     — Erros e avisos
#   info     — Informações gerais (recomendado para produção)
#   verbose  — Log detalhado (recomendado para desenvolvimento)
#   debug    — Log de depuração (máximo detalhe)
#
# Exemplo: Matrix_LOG_LEVEL=info
# [OPCIONAL — default: info]
# Matrix_LOG_LEVEL=info

# ═══════════════════════════════════════════════════════════════════════════════
#  GITHUB — Token de Acesso
# ═══════════════════════════════════════════════════════════════════════════════
# Token de acesso pessoal do GitHub para operações automatizadas.
# Usado pelo PR Generator (fallback REST API quando gh CLI não disponível),
# pelo release pipeline e pelo CI runner.
#
# Permissões necessárias: "repo" (para criar PRs), "workflow" (opcional)
# Gere em: https://github.com/settings/tokens
#
# Formato: string (começa com "ghp_" ou "github_pat_")
# Exemplo: GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# [OPCIONAL — necessário apenas se gh CLI não estiver disponível]
# GITHUB_TOKEN=

# ═══════════════════════════════════════════════════════════════════════════════
#  SECURITY — Secrets Scanner
# ═══════════════════════════════════════════════════════════════════════════════
# Configuração para o scanner de secrets em outputs de IA.
# Matrix_SECRETS_SCAN_ENABLED=false desativa a verificação de vazamento de secrets.
#
# ⚠️ Desabilitar o scanner reduz a segurança — não recomendado em produção.
#
# [OPCIONAL — default: true]
# Matrix_SECRETS_SCAN_ENABLED=true

# ═══════════════════════════════════════════════════════════════════════════════
#  SIEM — Destino de Exportação
# ═══════════════════════════════════════════════════════════════════════════════
# Configura o destino real para onde os eventos SIEM serão enviados via HTTP.
# Usado pelo setupSIEMDestination() e startPeriodicExport() no siem-exporter.js.
# NON-BLOCKING: se não configurado, o pipeline opera normalmente sem envio remoto.
#
# SIEM_ENDPOINT: URL do servidor SIEM que aceita POST com Content-Type: application/json
#   Exemplo: http://siem-server:8080/api/events
# SIEM_API_KEY: Chave opcional enviada como Bearer Token no header Authorization
#
# [OPCIONAL — default: vazio (apenas exportação local para disco)]
# SIEM_ENDPOINT=
# SIEM_API_KEY=

# ═══════════════════════════════════════════════════════════════════════════════
#  OPENCODE — Data Directory Path
# ═══════════════════════════════════════════════════════════════════════════════
# Caminho absoluto para o diretório de dados do OpenCode.
# Controla onde o OpenCode armazena: opencode.db (SQLite), auth.json,
# mcp-auth.json, fable-skills/, repos/, snapshot/, storage/, log/.
#
# Mecanismo de descoberta (JavaScript):
#   process.env.OPENCODE_DATA_DIR ?? path.join(os.homedir(), ".local/share/opencode")
#
# Se NÃO configurado, usa o default: C:\Users\<user>\.local\share\opencode\
# Para migrar para outro disco, configure este valor e mova os arquivos.
#
# Exemplo (valor anterior): OPENCODE_DATA_DIR=D:\OpenCode\.opencode-data
# [RECOMENDADO — default: ~/.local/share/opencode, ATUAL: D:\.opencode-data]
# OPENCODE_DATA_DIR=D:\.opencode-data
